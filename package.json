{
  "name": "sdk-by-early-bird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --parallel --filter demo-client --filter demo-server dev",
    "demo": "vp run --parallel --filter demo-client --filter demo-server dev",
    "demo:build": "vp run demo-client#build",
    "demo:server": "vp run demo-server#dev",
    "demo:preview": "vp run demo-client#preview",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
